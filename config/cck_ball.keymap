#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        mouse {
            bindings = <&tog 1>;
            key-positions = <6 7>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&tog 1>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&tog 1>;

            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESCAPE        &kp Q                 &kp W                &kp E      &kp R               &kp T       &kp Y         &kp U      &kp I          &kp O           &kp P           &kp LEFT_BRACE
&kp TAB           &kp A                 &kp S                &kp D      &lt 4 F             &kp G       &kp H         &kp J      &kp K          &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT    &kp Z                 &kp X                &kp C      &kp V               &kp B       &kp N         &kp M      &kp COMMA      &kp DOT         &kp UP_ARROW    &kp RIGHT_BRACE
&kp LEFT_CONTROL  &lt 5 LA(LEFT_SHIFT)  &mt LEFT_GUI C_MUTE  &kp SPACE  &mt LEFT_ALT SLASH  &new_macro  &lt 3 DELETE  &kp ENTER  &kp BACKSPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&scroll_vertical_encoder>;
        };

        mouse-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &mkp MB1      &mo 3         &mkp MB2      &mkp MB3      &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans      &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &new_macro  &trans        &trans        &trans        &trans        &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&scroll_vertical_encoder>;
        };

        num_layers {
            bindings = <
&kp GRAVE    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5   &kp NUMBER_6    &kp N7          &kp N8        &kp N9     &kp N0     &kp DEL
&kp CAPS     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp EQUAL  &kp F11
&trans       &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp HOME        &kp END         &kp PG_UP     &kp PG_DN  &kp MINUS  &kp F12
&bootloader  &trans  &trans  &trans  &trans  &trans   &mo 5           &trans          &trans        &trans     &trans     &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll-layers {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp T   &kp R   &kp E   &kp W   &kp Q   &kp ESCAPE
&trans  &trans    &trans  &trans    &trans      &kp GRAVE    &kp G   &kp F   &kp D   &kp S   &kp A   &kp SPACE
&trans  &trans    &trans  &trans    &trans      &kp TILDE    &kp B   &kp V   &kp C   &kp X   &kp Z   &kp LA(LEFT_SHIFT)
&trans  &trans    &trans  &trans    &mo 5       &trans       &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,，,,,,,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        settings-layers {
            bindings = <
&trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_TOG    &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE  &trans  &trans
&kp F1       &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &bt BT_CLR_ALL  &trans        &trans        &trans      &trans  &trans
&kp F7       &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &bt BT_CLR      &trans        &trans        &trans      &trans  &trans
&bootloader  &trans        &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans      &trans  &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
